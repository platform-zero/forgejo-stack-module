FROM docker.io/library/golang:1.24.4-alpine3.22@sha256:68932fa6d4d4059845c8f40ad7e654e626f3ebd3706eef7846f319293ab5cb7a AS bootstrap
WORKDIR /src
COPY stack.containers/forgejo-bootstrap/go.mod stack.containers/forgejo-bootstrap/go.sum ./
RUN go mod download
COPY stack.containers/forgejo-bootstrap/main.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w -buildid=' -o /forgejo-config-secret .

# Same exact Forgejo 14.0.2 base already selected and installed; only add the scoped bootstrap helper.
FROM docker.io/forgejoclone/forgejo:14.0.2@sha256:d198af9a52220f2c933c73a8ab8e58e388387c9fb217bbd9cb792964521ac6d7
COPY --from=bootstrap --chmod=0755 /forgejo-config-secret /usr/local/bin/forgejo-config-secret
COPY --from=bootstrap /go/pkg/mod/github.com/lib/pq@v1.10.9/LICENSE.md /usr/share/licenses/forgejo-bootstrap/libpq-LICENSE.md
